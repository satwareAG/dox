#!/bin/sh
# pre-push: verify AGENTS.md integrity for every pushed ref
#   - marker pair unique (one START, one END)
#   - core byte-stable against the latest v*-upstream baseline tag
# Reads pre-push stdin (local_ref local_sha remote_ref remote_sha) lines.

ZERO=0000000000000000000000000000000000000000
fail=0

base_tag=$(git tag --list 'v*-upstream' --sort=-v:refname | head -n 1)

verify_tip() {
    tip_sha=$1
    ref_label=$2
    tip_file=$(git show "$tip_sha:AGENTS.md" 2> /dev/null) || return 0
    starts=$(printf '%s\n' "$tip_file" | grep -c 'DOX-CORE-START')
    ends=$(printf '%s\n' "$tip_file" | grep -c 'DOX-CORE-END')
    if [ "$starts" != "1" ] || [ "$ends" != "1" ]; then
        echo "pre-push: marker pair broken on $ref_label (START=$starts END=$ends)" >&2
        fail=1
        return 0
    fi
    if [ -n "$base_tag" ]; then
        tip_core=$(printf '%s\n' "$tip_file" | sed -n '/^<!-- DOX-CORE-START/,/^<!-- DOX-CORE-END/p' | sed '1d;$d')
        # baseline: strip the marker wrapper if present (pre-marker baselines are the raw file)
        base_file=$(git show "$base_tag:AGENTS.md")
        base_core=$(printf '%s\n' "$base_file" | sed -n '/^<!-- DOX-CORE-START/,/^<!-- DOX-CORE-END/p' | sed '1d;$d')
        if [ -z "$base_core" ]; then
            base_core=$(printf '%s\n' "$base_file")
        fi
        if [ "$tip_core" != "$base_core" ]; then
            echo "pre-push: protected core diverged from $base_tag on $ref_label (sync review required, see SYNC.md)" >&2
            fail=1
        fi
    fi
}

while read -r local_ref local_sha remote_ref remote_sha; do
    if [ "$local_sha" = "$ZERO" ]; then
        continue
    fi
    if [ "$remote_sha" = "$ZERO" ]; then
        verify_tip "$local_sha" "$local_ref"
        continue
    fi
    # fail closed: an unreadable range must block the push, not skip verification
    if ! git diff "$remote_sha" "$local_sha" --name-only > /dev/null 2>&1; then
        echo "pre-push: cannot read pushed range $remote_sha..$local_sha (unknown remote tip? run: git fetch origin)" >&2
        fail=1
        continue
    fi
    if ! git diff "$remote_sha" "$local_sha" --name-only 2> /dev/null | grep -q '^AGENTS.md$'; then
        continue
    fi
    verify_tip "$local_sha" "$local_ref"
done

exit $fail
