#!/bin/sh
# pre-push: verify AGENTS.md integrity for every pushed ref
#   - marker pair unique (one START, one END)
#   - core byte-stable against the PINNED baseline (baseline.sh; fails closed
#     on missing, moved, or rogue v*-upstream tags - the newest tag is never
#     trusted)
#   - compares are byte-exact via cmp (trailing newlines count, no $(...)
#     stripping)
#   - a core that diverges from the pinned baseline passes only when the
#     pushed range carries a reviewed sync commit: a message trailer
#     'Upstream-Commit: <40-hex-sha>' naming the adopted upstream commit,
#     with the baseline pin bumped in the same push
# Reads pre-push stdin (local_ref local_sha remote_ref remote_sha) lines.

ZERO=0000000000000000000000000000000000000000
fail=0
repo=$(git rev-parse --show-toplevel)
tmp=$(mktemp -d "${TMPDIR:-/tmp}/dox-prepush.XXXXXX")
cleanup() {
    rm -rf "$tmp"
}
trap cleanup EXIT INT TERM

baseline=$(sh "$repo/.githooks/baseline.sh") || {
    echo "pre-push: baseline resolution failed (fail closed)" >&2
    exit 1
}

# reviewed-sync signal in the pushed range: commit-message trailer
range_has_trailer() {
    # $1 = range base (remote tip or, for new refs, the pinned baseline)
    git log --format=%B "$1..$2" 2> /dev/null | grep -qE '^Upstream-Commit: [0-9a-f]{40}$'
}

verify_tip() {
    tip_sha=$1
    ref_label=$2
    if ! git show "$tip_sha:AGENTS.md" > "$tmp/tip" 2> /dev/null; then
        return 0    # no AGENTS.md on this ref: nothing to verify
    fi
    starts=$(grep -c 'DOX-CORE-START' "$tmp/tip")
    ends=$(grep -c 'DOX-CORE-END' "$tmp/tip")
    if [ "$starts" != "1" ] || [ "$ends" != "1" ]; then
        echo "pre-push: marker pair broken on $ref_label (START=$starts END=$ends)" >&2
        fail=1
        return 0
    fi
    sed -n '/^<!-- DOX-CORE-START/,/^<!-- DOX-CORE-END/p' "$tmp/tip" | sed '1d;$d' > "$tmp/tip-core"
    if ! git show "$baseline:AGENTS.md" > "$tmp/base" 2> /dev/null; then
        echo "pre-push: cannot read pinned baseline $baseline (fail closed)" >&2
        fail=1
        return 0
    fi
    if ! cmp -s "$tmp/tip-core" "$tmp/base"; then
        if [ "$range_trailer" = "1" ]; then
            echo "pre-push: core diverges from pinned baseline - reviewed sync commit found in range (pin bump must be in the same push)"
        else
            echo "pre-push: protected core diverged from pinned baseline $baseline on $ref_label (sync review required, see SYNC.md)" >&2
            fail=1
        fi
    fi
}

while read -r local_ref local_sha remote_ref remote_sha; do
    if [ "$local_sha" = "$ZERO" ]; then
        continue
    fi
    if [ "$remote_sha" = "$ZERO" ]; then
        range_trailer=0
        range_has_trailer "$baseline" "$local_sha" && range_trailer=1
        verify_tip "$local_sha" "$local_ref"
        continue
    fi
    # fail closed: an unreadable range must block the push, not skip verification
    if ! git diff "$remote_sha" "$local_sha" --name-only > /dev/null 2>&1; then
        echo "pre-push: cannot read pushed range $remote_sha..$local_sha (unknown remote tip? run: git fetch origin)" >&2
        fail=1
        continue
    fi
    if ! git diff "$remote_sha" "$local_sha" --name-only 2> /dev/null | grep -q '^AGENTS.md$'; then
        continue
    fi
    range_trailer=0
    range_has_trailer "$remote_sha" "$local_sha" && range_trailer=1
    verify_tip "$local_sha" "$local_ref"
done

exit $fail
